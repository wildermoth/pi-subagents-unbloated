{
  "name": "pi-subagents-unbloated",
  "version": "0.0.0",
  "description": "Subagents for Pi. Nothing else.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "subagents",
    "agents",
    "extension"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench": "bun bench/startup.ts && bun bench/delegation.ts && bun bench/context.ts",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:coverage": "bun test --coverage"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0 <2",
    "@earendil-works/pi-tui": ">=1.4.0 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typebox": "^1.4.3",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  }
}
